# packages/contracts/env/.env.mainnet.example
#
# Used by Foundry deploy scripts for mainnet (Base). Local-only.

PRIVATE_KEY=

VRF_SUBSCRIPTION_ID=

ETHERSCAN_API_KEY=

TREASURY=
TREASURY_ADDRESS=

# REQUIRED. The backend wallet's address (same value as BACKEND_WALLET_ADDRESS in the backend
# env). Step 24 (24_GrantBackendWallet) grants it PAYMASTER_ROLE on InfoFiMarketFactory so its
# onPositionUpdate calls go through; DeployAll refuses to start without it. For an existing
# deploy or a rotated backend wallet, run scripts/grant-backend-wallet.sh --network <network>
# (it reads the backend env when this is blank).
BACKEND_WALLET_ADDRESS=

# Uniswap v4 PoolManager on this chain — see the testnet example for why it is not
# hardcoded in Solidity. Blank skips the launchpad's placer step.
POOL_MANAGER_ADDRESS=

SEASON_NAME="Season 1"
DURATION_SECS=2592000
START_TIME=

RAFFLE=
