# packages/backend/env/.env.mainnet.example
#
# Backend runtime env vars for the mainnet (Base) deploy.
# Pushed to Railway by `./scripts/deploy-env.sh --network mainnet`.
#
# Same shape as .env.testnet.example. Differences: NETWORK=MAINNET,
# CORS_ORIGINS includes the production custom domain, mainnet RPC URLs.

# ── Required ──
NETWORK=MAINNET
NODE_ENV=production

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RPC_URL=

BACKEND_WALLET_PRIVATE_KEY=
BACKEND_WALLET_ADDRESS=

JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGINS=https://secondorder.fun,https://secondorder.fun,https://sof-beta-frontend.vercel.app

# ── Redis ──
# Do NOT add REDIS_URL — on Railway it is the reference ${{Redis.REDIS_URL}}
# (the project's Redis service), and deploy-env.sh never pushes it.

# ── Rate limiting ──
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=1 minute

# ── Feature integrations ──
BLOCKSCOUT_BASE_URL=https://base.blockscout.com
BLOCKSCOUT_API_KEY=
HATS_PROTOCOL=
HATS_SPONSOR_HAT_ID=
HATS_STAKING_ELIGIBILITY=

# TokenLaunchpad deploy block: where launchTradeListener starts reading the
# launchpad's RouterUpdated history (trusted routers). Normally read from
# deployments/<network>.json (deployBlocks.TokenLaunchpad, recorded by
# scripts/extract-deployment-addresses.js); set this only to override it.
# LAUNCHPAD_DEPLOY_BLOCK=
